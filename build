#!/usr/bin/env nix-shell
#!nix-shell -i bash -p nix-output-monitor jq

eval "nom build .#nixosConfigurations.{$(nix eval .#hosts --apply 'attr: builtins.filter (x: x != null) (builtins.attrValues (builtins.mapAttrs (n: v: if v.active then n else null) attr))' --json | jq --raw-output '@csv')}.config.system.build.toplevel -j6"
